# TAILER - Local Development Environment Variables
# Prefix all TAILER application settings with TAILER_

# ============================================
# Core Application
# ============================================
TAILER_APP_NAME=TAILER
TAILER_DEBUG=false
TAILER_BACKEND_URL=http://localhost:8000
TAILER_FRONTEND_URL=http://localhost:3000

# ============================================
# Database (PostgreSQL)
# ============================================
# Docker service name: postgres
TAILER_DATABASE_URL=postgresql://tailer_user:tailer_password@postgres:5432/tailer
TAILER_REPOSITORY_BACKEND=sqlalchemy
TAILER_DEFAULT_PROJECT_ID=proj_hackathon_2026
TAILER_DEFAULT_PROVIDER=mock

# Postgres service credentials (for docker-compose)
POSTGRES_DB=tailer
POSTGRES_USER=tailer_user
POSTGRES_PASSWORD=tailer_password

# ============================================
# Cache (Redis)
# ============================================
# Docker service name: redis
TAILER_REDIS_URL=redis://redis:6379

# ============================================
# Security & JWT
# ============================================
# Dashboard tokens use the JWT-specific secret, algorithm, and lifetime below.
# TAILER_SECRET_KEY is reserved for other application signing/encryption work.
TAILER_SECRET_KEY=your-secret-key-change-in-production
TAILER_JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
TAILER_JWT_ALGORITHM=HS256
TAILER_JWT_EXPIRATION_MINUTES=30
TAILER_SUB_API_KEY_PEPPER=development-sub-api-key-pepper-change-in-production
# Stable HMAC secret for metadata-only runtime idempotency identities.
TAILER_IDEMPOTENCY_KEY_PEPPER=development-idempotency-key-pepper-change-in-production
TAILER_IDEMPOTENCY_RETENTION_DAYS=30

# ============================================
# Provider Credential Vault & Routing
# ============================================
# JSON mapping of key version to a URL-safe base64 AES-256 key. Keep every
# version needed to decrypt existing rows; new writes use the active version.
# Leave empty only when using the mock provider. Generate a key with:
# cd backend && python -c "from app.credential_security import generate_credential_encryption_key as g; print(g())"
TAILER_CREDENTIAL_ENCRYPTION_KEYS={}
TAILER_CREDENTIAL_ACTIVE_KEY_VERSION=v1
TAILER_OPENAI_BASE_URL=https://api.openai.com/v1
TAILER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
TAILER_PROVIDER_TIMEOUT_SECONDS=30
