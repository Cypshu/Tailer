# TAILER - Local Development Environment Variables

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Configuration
FRONTEND_PORT=3000

# Database Configuration
POSTGRES_DB=tailer
POSTGRES_USER=tailer_user
POSTGRES_PASSWORD=tailer_password
DATABASE_URL=postgresql://tailer_user:tailer_password@postgres:5432/tailer

# Redis Configuration
REDIS_URL=redis://redis:6379

# API Configuration
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Security (for production, use strong values)
SECRET_KEY=your-secret-key-change-in-production

# LLM Provider Keys (examples - set to empty for MVP)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENROUTER_API_KEY=
