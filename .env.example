# TAILER - Local Development Environment Variables
# Prefix all TAILER application settings with TAILER_

# ============================================
# Core Application
# ============================================
TAILER_APP_NAME=TAILER
TAILER_DEBUG=true
TAILER_BACKEND_URL=http://localhost:8000
TAILER_FRONTEND_URL=http://localhost:3000

# ============================================
# Database (PostgreSQL)
# ============================================
# Docker service name: postgres
TAILER_DATABASE_URL=postgresql://tailer_user:tailer_password@postgres:5432/tailer

# Postgres service credentials (for docker-compose)
POSTGRES_DB=tailer
POSTGRES_USER=tailer_user
POSTGRES_PASSWORD=tailer_password

# ============================================
# Cache (Redis)
# ============================================
# Docker service name: redis
TAILER_REDIS_URL=redis://redis:6379

# ============================================
# Security & JWT
# ============================================
# Dashboard tokens use the JWT-specific secret, algorithm, and lifetime below.
# TAILER_SECRET_KEY is reserved for other application signing/encryption work.
TAILER_SECRET_KEY=your-secret-key-change-in-production
TAILER_JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
TAILER_JWT_ALGORITHM=HS256
TAILER_JWT_EXPIRATION_MINUTES=30

# ============================================
# External LLM Provider Keys (examples - set to empty for MVP)
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENROUTER_API_KEY=
